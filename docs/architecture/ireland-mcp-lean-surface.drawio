<mxCell id="rednote" value="&lt;b&gt;higher than all-tool cost + routing overhead&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontSize=17;fontColor=#0B2545;align=center;verticalAlign=middle;fontFamily=Inter,Helvetica,Arial;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="500" width="580" height="40" as="geometry"/></mxCell>
<mxCell id="trick" value="&lt;b&gt;The trick&lt;/b&gt;&lt;br&gt;Seven universal tools stay in context: catalogue, describe, call, about, search, fetch and nearby. The operation index lives inside ireland_call, so agents discover all 74 operations without paying every schema on every turn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0B2545;strokeWidth=1.2;fontSize=14;fontColor=#122033;fontFamily=Inter,Helvetica,Arial;arcSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="635" width="590" height="116" as="geometry"/></mxCell>
<mxCell id="matrix" value="&lt;b&gt;Eval matrix&lt;/b&gt;&lt;br&gt;gpt-5.6-luna: 100% / 100%&lt;br&gt;gpt-5.4-mini: 91% / 97%&lt;br&gt;gpt-4.1-nano: 84% / 90%&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748B&quot;&gt;default / all surfaces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E40C9;strokeWidth=1.2;fontSize=14;fontColor=#122033;fontFamily=Inter,Helvetica,Arial;arcSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="635" width="310" height="116" as="geometry"/></mxCell>
<mxCell id="ci" value="&lt;b&gt;Guardrail&lt;/b&gt;&lt;br&gt;CI fails if default tools/list exceeds 16,000 chars." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#F2C14E;strokeWidth=1.2;fontSize=14;fontColor=#122033;fontFamily=Inter,Helvetica,Arial;arcSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="635" width="240" height="116" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>