<mxCell id="l2" value="&lt;b&gt;One server per source&lt;/b&gt;&lt;br&gt;28+ servers&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#64748B&quot;&gt;repeated manifests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D1495B;strokeWidth=1.2;fontSize=14;fontColor=#122033;fontFamily=Inter,Helvetica,Arial;arcSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="230" height="92" as="geometry"/></mxCell>
