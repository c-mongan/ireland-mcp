<mxfile host="drawio"><diagram name="Why the surface is lean" id="Why the surface is lean"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="820" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Why it is lean&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontColor=#0B2545;align=left;verticalAlign=middle;fontFamily=Inter,Helvetica,Arial;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="36" y="24" width="900" height="34" as="geometry"/></mxCell>
