<mxCell id="note1" value="&lt;b&gt;Live args&lt;/b&gt;&lt;br&gt;{ source: &quot;geohive&quot;, operation: &quot;geohive_locate&quot;, args: { name: &quot;Ballymun&quot; } }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;fontSize=12;fontColor=#122033;fontFamily=Inter,Helvetica,Arial;arcSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry x="92" y="705" width="390" height="62" as="geometry"/></mxCell>
<mxCell id="note2" value="&lt;b&gt;Why agents trust it&lt;/b&gt;&lt;br&gt;Every normal result includes publisher, source URL, licence, retrieval time and truncation metadata." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#65A30D;strokeWidth=1.2;fontSize=12;fontColor=#122033;fontFamily=Inter,Helvetica,Arial;arcSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry x="530" y="705" width="520" height="62" as="geometry"/></mxCell>
<mxCell id="note3" value="&lt;b&gt;Safety&lt;/b&gt;&lt;br&gt;No writes. No login. Public data only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#169B62;strokeWidth=1.2;fontSize=12;fontColor=#122033;fontFamily=Inter,Helvetica,Arial;arcSize=18;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="705" width="230" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>