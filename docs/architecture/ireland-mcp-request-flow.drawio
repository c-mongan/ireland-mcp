<mxCell id="s6" value="&lt;b&gt;6.&lt;/b&gt; Agent writes a cited plain-English answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B2545;strokeWidth=1.4;fontSize=12;fontColor=#122033;fontFamily=Inter,Helvetica,Arial;arcSize=10;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="606" width="1000" height="42" as="geometry"/></mxCell>
