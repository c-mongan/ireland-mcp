{
  "schema_version": "0.1",
  "name": "Ireland MCP",
  "id": "io.github.c-mongan/ireland-mcp",
  "description": "Read-only MCP server for Irish public data. No keys, no login.",
  "homepage": "https://irishopendata.com/",
  "repository": "https://github.com/c-mongan/ireland-mcp",
  "license": "MIT",
  "protocol": {
    "name": "model-context-protocol",
    "versions": [
      "2025-06-18",
      "2025-11-25"
    ]
  },
  "transports": [
    {
      "type": "http",
      "url": "https://mcp.irishopendata.com/mcp",
      "auth": {
        "type": "none"
      }
    }
  ],
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": true,
    "sampling": false
  },
  "toolsets": {
    "default": "Lean cross-source surface of 7 tools, about 2.1k tokens.",
    "all": "Append ?toolsets=all to list every typed source tool.",
    "source": "Use /mcp/x/{source-id} or ?toolsets={source-id} for one source."
  },
  "agent_docs": "https://irishopendata.com/AGENTS.md",
  "llms_txt": "https://irishopendata.com/llms.txt",
  "status": "https://raw.githubusercontent.com/c-mongan/ireland-mcp/status/status/status.json",
  "prompts": [
    "area_profile",
    "commute_check",
    "compare_counties"
  ],
  "counts": "https://irishopendata.com/counts.json"
}
