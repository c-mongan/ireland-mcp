{
  "name": "ireland-mcp",
  "version": "1.1.4",
  "description": "Read-only Model Context Protocol server for Irish public data: CSO, Oireachtas, GeoHive, data.gov.ie, Smart Dublin, Met Éireann, planning, heritage, environment and more.",
  "license": "MIT",
  "author": "Conor Mongan",
  "type": "module",
  "main": "dist/src/functions/*.js",
  "bin": {
    "ireland-mcp": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "!dist/src/**/*.test.js",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c-mongan/ireland-mcp.git"
  },
  "mcpName": "io.github.c-mongan/ireland-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ireland",
    "open-data",
    "cso",
    "oireachtas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "deploy:zip": "bash scripts/deploy-zip.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "func start",
    "stdio": "node dist/src/cli.js",
    "dev:http": "node scripts/dev-http.mjs",
    "inspector:check": "node scripts/inspector-check.mjs",
    "live:sanity": "node scripts/live-sanity.mjs",
    "live:all": "npm run build && node scripts/live-all-ops.mjs",
    "measure:tools": "node scripts/measure-tools.mjs",
    "counts": "npm run build && node scripts/counts.mjs",
    "ppr:build": "node dist/src/sources/ppr/buildIndexCli.js",
    "eval": "node scripts/eval.mjs",
    "prepublishOnly": "npm run build",
    "skills:package": "node scripts/package-skills.mjs",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --exact-port --no-open",
    "build-storybook": "storybook build --disable-telemetry",
    "test:storybook": "playwright test --config storybook/playwright.config.ts",
    "chromatic": "chromatic --storybook-build-dir=storybook-static",
    "typecheck:storybook": "tsc -p storybook/tsconfig.json",
    "test:storybook-mcp": "node scripts/check-storybook-mcp.mjs",
    "check:mcp": "node scripts/check-mcp.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && node --test test/infra-arm.mjs test/deploy-zip.mjs test/status-checkout.mjs && npm run check:mcp",
    "check:ui": "npm run typecheck:storybook && npm run test:storybook-mcp && npm run build-storybook && npm run test:e2e && npm run test:storybook"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.16.5",
    "@azure/identity": "^4.13.3",
    "@azure/monitor-opentelemetry": "1.20.0",
    "@azure/storage-blob": "^12.34.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "1.9.1",
    "fast-xml-parser": "^5.11.2",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "chromatic": "^18.12.0",
    "eslint": "^10.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
